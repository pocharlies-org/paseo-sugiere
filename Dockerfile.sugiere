# El servicio `sugiere` (docs/servicio-sugiere.md): sin dependencias en ejecución, así que la imagen lleva solo las fuentes.
# Node 22 ejecuta TypeScript sin compilar (`--experimental-strip-types`); el servicio importa shared/, el mismo código que el plugin.
FROM node:22-alpine
WORKDIR /app
COPY shared ./shared
COPY service ./service
ENV NODE_ENV=production
EXPOSE 8080
USER node
CMD ["node", "--experimental-strip-types", "service/server.ts"]